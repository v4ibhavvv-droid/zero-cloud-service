# ═════════════════════════════════════════════════════════════════
#  ZERO CLOUD SERVICE — client environment variables
#  Ise apne terminal me `source .env` karke use karo, ya Makefile targets
# ═════════════════════════════════════════════════════════════════

# ── AWS (Floci — main engine) ────────────────────────────────────
export AWS_ENDPOINT_URL=http://localhost:4566
export AWS_DEFAULT_REGION=us-east-1
export AWS_ACCESS_KEY_ID=test
export AWS_SECRET_ACCESS_KEY=test

# ── AWS Emulator (official) — HTTPS self-signed cert ke saath ────
# Cert path floci-aws start hone ke baad ./data/aws-emulator/9297/ me banta hai:
# export AWS_EMULATOR_ENDPOINT=https://localhost:9297
# export AWS_CA_BUNDLE="$(pwd)/data/aws-emulator/9297/ca-cert.pem"  (exact filename check karo)

# ── AZURE (floci-az) ─────────────────────────────────────────────
export AZURE_STORAGE_CONNECTION_STRING="UseDevelopmentStorage=true"

# ── AZURE (Azurite — Storage Explorer ke liye paste-string) ──────
# DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;QueueEndpoint=http://127.0.0.1:10001/devstoreaccount1;TableEndpoint=http://127.0.0.1:10002/devstoreaccount1;

# ── GCP (fake-gcs + official emulators) ──────────────────────────
export STORAGE_EMULATOR_HOST=http://localhost:4443/storage/v1
export PUBSUB_EMULATOR_HOST=localhost:8085
export FIRESTORE_EMULATOR_HOST=localhost:8086

# ── GCP (Cloudbox extra services) ────────────────────────────────
export CLOUDBOX_BASE=http://localhost
# Ports: 18443 GCS | 18080 Firestore | 18085 PubSub gRPC | 18086 PubSub REST
#        8090 Secrets | 8123 Tasks | 9050 BigQuery | 9010 Spanner
#        9020 Logging | 8091 Scheduler | 8092 KMS | 8888 Admin UI

# ── GUIs ─────────────────────────────────────────────────────────
# floci-ui (teeno clouds):  http://localhost:4510
# floci built-in AWS console: http://localhost:4500  (auto-start hota hai)
# gcp-ui (GCP deep view):   http://localhost:9090
# cloudbox admin:           http://localhost:8888
# floci AWS console:        http://localhost:4566/_floci/ui
# landing page:             http://localhost:3010
